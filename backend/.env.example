# CORS 관련 (JSON 배열 형식)
CORS_ORIGINS=["http://localhost:3000"]

# GOOGLE APP 관련
MY_GOOGLE_EMAIL=
GOOGLE_APP_PW=

# JWT 관련
JWT_ALGORITHM=HS256
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE=30  # 30분
REFRESH_TOKEN_EXPIRE=1  # 1일

# DB(Supabase - Postgres DB) 관련
DB_URL=postgresql://:5432
# DB_ECHO=True  # 개발용(True), 운영용(False:기본값(주석처리 하면 됨) 

# Redis(Cloud) 관련
REDIS_URL=redis://:11618

# S3(AWS) 관련
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_FOLDER=omnisense
AWS_S3_PRESIGNED_EXPIRE=3600

# Vector DB(Qdrant) 관련
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=omnisense
VECTOR_DB_TIMEOUT=10

# Embedding 관련
# EMBEDDING_BASE_URL: 선택값 (embedding.py 작업 전까지는 비워둬도 서버 실행 가능)
EMBEDDING_BASE_URL=http://localhost:8081/v1
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60
